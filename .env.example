# OAuth-токен Яндекса с доступом к Яндекс.Директу и Яндекс.Метрике (metrika:read)
YANDEX_OAUTH_TOKEN=
# Необязательно: отдельные токены для Директа и Метрики (по умолчанию используется YANDEX_OAUTH_TOKEN)
YANDEX_DIRECT_TOKEN=
YANDEX_METRIKA_TOKEN=
# Логин клиента Директа — нужен только для агентского аккаунта
DIRECT_CLIENT_LOGIN=
# Номер счетчика Яндекс.Метрики и модель атрибуции
METRIKA_COUNTER_ID=
METRIKA_ATTRIBUTION=automatic

# База данных PostgreSQL (создается автоматически при первом запуске)
POSTGRES_DB=ad_reporting
POSTGRES_USER=ad_reporting
POSTGRES_PASSWORD=change_me

# Первый администратор — создается при первом запуске, если такого пользователя еще нет
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change_me_too

# Порт веб-интерфейса на хосте
FRONTEND_PORT=3000

# Фоновая синхронизация справочников кампаний и целей
ENABLE_SCHEDULED_SYNC=false
SYNC_INTERVAL_MINUTES=30

LOG_LEVEL=INFO
